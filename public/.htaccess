Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# Jika ada URL tanpa akhiran garis miring (slash) dan itu adalah direktori,
# tambahkan garis miring agar Apache bisa meload index.html di dalamnya.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ $1/ [R=301,L]
